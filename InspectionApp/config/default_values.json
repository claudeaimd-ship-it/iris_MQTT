    "check_signal_interval_ms": 0,
    "restart_pin": "2679",
    "cycle_watchdog_timeout_s": 60,
    "camera_capture_resolution": [
        4608,
        2592
    ],
    "camera_preview_resolution": [
        320,
        240
    ],
    "csi_channels": [
        {
            "name": "A",
            "i2c_cmd": "i2cset -y 10 0x70 0x00 0x04",
